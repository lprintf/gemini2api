# Gemini2API Docker 环境配置示例
# 复制此文件为 .env 并根据需要修改

# API 服务端口
API_PORT=

# RDP 端口（有头模式调试用）
RDP_PORT=

# 时区
TZ=Asia/Shanghai

# Docker Compose 项目名称
COMPOSE_PROJECT_NAME=gemini2api

# 网关网络名称
GATEWAY_NETWORK_NAME=gateway

# ==================== 身份认证配置 ====================
# 管理员账号（保护 /admin 和 /api/admin/* 接口）
# 优先级：环境变量 > 数据库配置 > 默认值
# 默认账号: admin/changeme
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme