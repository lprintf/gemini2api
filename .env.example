# Gemini2API Docker 环境配置示例
# 复制此文件为 .env 并根据需要修改

# API 服务端口
FRONTEND_PORT=

# 是否启用桌面环境（Weston RDP，用于调试）
# 默认 false，生产环境无需开启
ENABLE_DESKTOP=false

# 时区
TZ=Asia/Shanghai

# Docker Compose 项目名称
COMPOSE_PROJECT_NAME=gemini2api

# 网关网络名称
GATEWAY_NETWORK_NAME=gateway

# Data 目录（包含 browser_data, gemini.db, logs, outputs 等）
DATA_DIR=./data

# ==================== 身份认证配置 ====================
# 管理员账号（保护 /admin 和 /api/admin/* 接口）
# 优先级：环境变量 > 数据库配置 > 默认值
# 默认账号: admin/changeme
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme